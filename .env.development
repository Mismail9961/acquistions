# --- Neon Local (required for docker-compose.dev.yml `neon-local` service) ---
# The `neon-local` service loads this file; keep API credentials here for Compose.
# Create an API key: https://neon.com/docs/manage/api-keys
NEON_API_KEY=napi_9noswn6wgxo58om1xgtu7fgbnyw58mxus2cu164406bluxkgptleb1h0ir0ko83u
# Project ID: Neon Console → Project settings → General
NEON_PROJECT_ID=billowing-dawn-05417337
# Optional: ephemeral branches are created from this parent (omit to use project default branch)
PARENT_BRANCH_ID=br-bitter-tree-an6q9fxt

# If host port 5432 is already taken, set in shell or a .env file loaded by Compose:
# NEON_LOCAL_HOST_PORT=5433

# --- App: connect through Neon Local (compose service hostname) ---
# Credentials are fixed by Neon Local: user `neon`, password `npg`.
# Replace `neondb` with your Neon database name if different.
NEON_LOCAL=true
NEON_LOCAL_HOST=neon-local
DATABASE_URL=postgresql://neondb_owner:npg_tuk1AGhL5lwr@ep-cold-recipe-ani7btfi-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# When running the app on your host (npm run dev) with only Neon Local in Docker, use:
# DATABASE_URL=postgres://neon:npg@localhost:5432/neondb
# NEON_LOCAL_HOST=localhost

NODE_ENV=development
PORT=3000
ARCJET_KEY=ajkey_01kn9k6vwgf2q9w1mvzrxh2gp0

# Add other secrets (JWT, Arcjet, etc.) for local dev as needed.
